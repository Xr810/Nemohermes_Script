# Optional runtime override. Copy to .env only for keys you want to change
# without rebuilding the image. Docker Compose injects .env into the container
# and those values win over Dockerfile ENV.
#
#   cp .env.example .env
#   # edit the lines you need
#   docker compose up -d
#
# Omit a variable (or delete the line) to keep the Dockerfile default.
# Do not leave INFERENCE_API_KEY= empty here if the image already has a key —
# an empty value would override the baked one.

# INFERENCE_BASE_URL=https://openrouter.ai/api/v1
# INFERENCE_MODEL=deepseek/deepseek-v4-flash
# INFERENCE_API_KEY=
# SANDBOX_NAME=test
# APPROVALS_MODE=smart
# MCP_URL=
# MCP_ROUTER_TOKEN=
# FORWARD_BIND=0.0.0.0
# Extra images to pull if missing (space-separated):
# SANDBOX_PULL_IMAGES=
