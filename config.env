#!/usr/bin/env bash
# ============================================================
# NemoHermes Linux deployment config
# The wizard fills these in; Enter keeps the current value.
# Secrets (API key, MCP token) are never written here.
# ============================================================

# ---- Basics ----
SANDBOX_NAME=""
AGENT="hermes"

# ---- Inference endpoint (used by onboard; URL/model/key all required) ----
# OpenAI-compatible, e.g. https://openrouter.ai/api/v1 or http://192.168.1.50:8000/v1
# Not https://inference.local/v1 — that is sandbox-internal and the probe fails.
INFERENCE_BASE_URL=""
INFERENCE_MODEL=""
INFERENCE_API_KEY="${INFERENCE_API_KEY:-}"

# ---- Approvals: off | smart | manual; empty = leave unchanged ----
APPROVALS_MODE="manual"

# ---- MCP Router (optional; empty = skip) ----
# Public HTTPS only. MCP_ENV_VAR is the credential variable *name*, not the token.
MCP_URL=""
MCP_ENV_VAR="MCP_ROUTER_TOKEN"

# ---- Open WebUI: port inside the sandbox, port forwarded to localhost ----
WEBUI_PORT="3000"
WEBUI_LOCAL_PORT="3000"

# ---- Hermes API / dashboard forward ports (space-separated; empty = skip) ----
FORWARD_PORTS="8642 18789 19119"

# ---- Timeouts (seconds): sandbox Ready, browser admin creation ----
SANDBOX_WAIT_SECS="120"
ADMIN_WAIT_SECS="600"

# ---- Resource paths (self-contained; copy the whole folder to move it) ----
DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESOURCES_DIR="${DEPLOY_DIR}/resources"
OPENWEBUI_FRESH_DB="${RESOURCES_DIR}/open-webui-fresh.db"
OPENWEBUI_START_SH="${RESOURCES_DIR}/start.sh"
OPENWEBUI_INSTALL_SH="${RESOURCES_DIR}/install.sh"
OPENWEBUI_PDF_TOOL="${RESOURCES_DIR}/hermes_source_tool.py"
OPENWEBUI_FILTER_SRC="${RESOURCES_DIR}/hermes_source_files.py"
OPENWEBUI_FILTER_INSTALLER="${RESOURCES_DIR}/install-hermes-source-filter.py"
DOCKERFILE="${RESOURCES_DIR}/Dockerfile"
