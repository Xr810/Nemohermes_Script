#!/usr/bin/env bash
# ============================================================
# NemoHermes Linux 部署配置（部署者填写）
# 所有路径均可按目标机器调整。修改后保存即可。
# ============================================================

# ---- 基础 ----
# 沙箱名（NemoClaw 创建的 sandbox 名称）。
# 留空时部署向导会强制要求输入（Enter 保留当前值）。
SANDBOX_NAME=""

# Agent 运行时（保持 hermes）
AGENT="hermes"

# ---- 推理端点（onboard 时使用，生产必填）----
# 推理服务地址（OpenAI 兼容，不同环境可换不同端点）。
# 示例: https://openrouter.ai/api/v1 | https://xxx.openai.azure.com/openai/v1 | http://192.168.1.50:8000/v1
# 留空时部署向导会强制要求输入（Enter 保留当前值）。
# 不要填 https://inference.local/v1 —— 那是 OpenShell 沙箱内的虚拟路由名，onboard 探测会失败。
INFERENCE_BASE_URL=""
# 默认模型（必填；向导会强制输入，Enter 保留当前值）
INFERENCE_MODEL=""
# API key：部署时优先从环境变量 INFERENCE_API_KEY 读取；
# 未设置则交互式提示输入。key 不写入本文件。
INFERENCE_API_KEY="${INFERENCE_API_KEY:-}"

# ---- 是否免审批（approvals.mode）----
# 值: off=免审批 | manual=默认要审批 | smart=智能审批
# 留空表示不修改（保持 onboard 默认 manual）
APPROVALS_MODE="manual"

# ---- MCP Router（可选，留空跳过）----
# 生产 MCP 地址（OpenShell managed MCP 要求公网 HTTPS）
MCP_URL=""
# 凭证环境变量名（NemoClaw 用它从 OpenShell provider store 解析）。
# Token 本身由向导第 5 题或环境变量 MCP_ROUTER_TOKEN 传入，禁止写入本文件。
MCP_ENV_VAR="MCP_ROUTER_TOKEN"

# ---- Open WebUI ----
# 沙箱内端口（保持 3000）
WEBUI_PORT="3000"
# 对外访问方式：forward（本地转发）或 proxy（反向代理，需自配）
# forward 时绑定本机端口：
WEBUI_LOCAL_PORT="3000"

# ---- Hermes API / Dashboard 转发端口（可选，本地访问用）----
# 空格分隔；留空跳过
FORWARD_PORTS="8642 18789 19119"

# ---- 超时 ----
# 等待 sandbox Ready 的秒数
SANDBOX_WAIT_SECS="120"
# 等待 Open WebUI 管理员创建的秒数（超时后提示手动继续）
ADMIN_WAIT_SECS="600"

# ---- 内部：资源路径（自包含，无需修改）----
# 所有资源都在本 deploy 文件夹的 resources/ 子目录里，整文件夹拷贝即可迁移
DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESOURCES_DIR="${DEPLOY_DIR}/resources"
OPENWEBUI_FRESH_DB="${RESOURCES_DIR}/open-webui-fresh.db"
OPENWEBUI_START_SH="${RESOURCES_DIR}/start.sh"
OPENWEBUI_INSTALL_SH="${RESOURCES_DIR}/install.sh"
OPENWEBUI_PDF_TOOL="${RESOURCES_DIR}/hermes_source_tool.py"
OPENWEBUI_FILTER_SRC="${RESOURCES_DIR}/hermes_source_files.py"
OPENWEBUI_FILTER_INSTALLER="${RESOURCES_DIR}/install-hermes-source-filter.py"
DOCKERFILE="${RESOURCES_DIR}/Dockerfile"
